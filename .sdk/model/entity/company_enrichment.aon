# Entity: company_enrichment

main: kit: entity: company_enrichment: {

  alias: field: {}

  fields: [
    {
      name: "company_id"
      req: false
      short: "Unique identifier for the company"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Company description"
      type: "`$STRING`"
    }
    {
      name: "domain"
      req: false
      short: "Company website domain"
      type: "`$STRING`"
    }
    {
      name: "email"
      req: false
      short: "Company contact email"
      type: "`$STRING`"
    }
    {
      name: "employee_count"
      req: false
      short: "Number of employees"
      type: "`$INTEGER`"
    }
    {
      name: "founded_year"
      req: false
      short: "Year the company was founded"
      type: "`$INTEGER`"
    }
    {
      name: "industry"
      req: false
      short: "Primary industry"
      type: "`$STRING`"
    }
    {
      name: "location"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "logo_url"
      req: false
      short: "URL to company logo"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Company name"
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "Company phone number"
      type: "`$STRING`"
    }
    {
      name: "revenue"
      req: false
      short: "Estimated revenue range"
      type: "`$STRING`"
    }
    {
      name: "social_profiles"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "technologies"
      req: false
      short: "List of technologies used by the company"
      type: "`$ARRAY`"
    }
  ]

  name: "company_enrichment"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "company_id"
                orig: "company_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "example.com"
                kind: "query"
                name: "domain"
                orig: "domain"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Example Inc"
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/enrich"
          parts: [
            "v1"
            "enrich"
          ]
          select: {
            exist: [
              "company_id"
              "domain"
              "name"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
